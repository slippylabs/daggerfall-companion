{"v":1,"classicMinutes":527010,"locationKey":"world","world":{"pixel":{"x":199,"y":209}},"items":[{"name":"Book","questItem":true,"questUID":101,"questSymbol":{"original":"_book_","name":"book"}}],"quest":{"machine":{"siteLinks":[],"quests":[{"uid":102,"questComplete":false,"questSuccess":false,"questName":"M0B00Y00","displayName":"Hunt for a Lycanthrope","factionId":0,"questStartTime":0,"questTombstoned":false,"questTombstoneTime":0,"smallerDungeonsState":0,"compiledByVersion":"","activeLogMessages":[{"stepID":0,"messageID":1030,"time":1}],"messages":[{"id":1000,"lines":["<ce>We've got a little job you might be interested in.","<ce>Seems there's a loup -- whatcha call your basic","<ce>werewolf, wereboar, or some kind o' werebeasty","<ce>that's been bothering a lot of farmers","<ce>in the area, and we need someone to kill it.","<ce>It'll mean _reward_ gold in your pocket. That sound","<ce>interesting to you?"]},{"id":1001,"lines":["<ce>Fine. Guess someone else'll have to do it."]},{"id":1002,"lines":["<ce>Great. You'll find the loup over in","<ce>___mondung_. We need the poor","<ce>brute dead in =1stparton_ days, so you","<ce>better be on your way, kid."]},{"id":1003,"lines":["<ce>Loup too much for you, kid, or didn't you","<ce>even try? Ah well, it's probably moved on","<ce>by now anyhow. Too bad."]},{"id":1004,"lines":["<ce>Good job, Loup-killer. Enjoy yer gold."]},{"id":1005,"lines":["I've heard there's some kind of werewolf on the loose around here.","<--->","I hear the wereboar's found a lair in someplace called ___mondung_.","<--->","Didja hear that howling last night? Wolf howling?"]},{"id":1006,"lines":["Werewolves are real nomads, I guess. I hear our loup moved down south.","<--->","My cousin tells me that our wereboar was spotted down south a ways."]},{"id":1007,"lines":["I hear they found out that werething was a priest during the day!","<--->","A lot of people feel safer knowing that werebeast is dead.","<--->","You heard about that werewolf some %ra hunted down?"]},{"id":1008,"lines":["<ce>Thanks for taking care of that werecritter %pcf."]},{"id":1009,"lines":["<ce>Get outta here. You're so pathetic.","<ce>You couldn't even handle a werewolf."]},{"id":1020,"lines":["<ce>The lycanthrope threat is ended."]},{"id":1021,"lines":["<ce>This must be the \"werebeast\"","<ce>everyone is afraid of. Just","<ce>an ordinary grizzly bear."]},{"id":1030,"lines":["%qdt:"," The Fighters Guild of"," ___questgiver_ has hired"," me to kill a troublesome werewolf,"," wereboar, or whatever, in its lair,"," ___mondung_. The beast needs"," to be dead in =1stparton_ days"," time for me to collect my payment."]},{"id":1080,"lines":["<ce>Here's a map to a place called","<ce>___newdung_.  All the killing","<ce>and treasure you can handle.","<ce>Knock yourself out."]}],"resources":[{"type":"Item","symbol":{"original":"_reward_"},"infoMessageID":-1,"usedMessageID":-1,"rumorsMessageID":0,"hasPlayerClicked":false,"isHidden":false,"resourceSpecific":{"artifact":false,"useClicked":false,"actionWatching":false,"allowDrop":false,"playerDropped":false,"madePermanent":false,"item":{"group":"Currency","templateIndex":276,"name":"Gold Pieces","value":1,"stackCount":75,"questItem":true,"questUID":9,"questSymbol":{"original":"_reward_","name":"reward"}}}},{"type":"Person","symbol":{"original":"_questgiver_"},"infoMessageID":-1,"usedMessageID":-1,"rumorsMessageID":0,"hasPlayerClicked":false,"isHidden":false,"resourceSpecific":{"race":-1,"nameBank":null,"npcGender":0,"faceIndex":-1,"nameSeed":-1,"isQuestor":false,"isIndividualNPC":false,"isIndividualAtHome":false,"displayName":"Lord Kain Mastercroft","homePlaceSymbol":{"original":"_questgiver_home_"},"lastAssignedPlaceSymbol":null,"assignedToHome":false,"factionID":0,"factionTableKey":"","questorData":{"hash":0,"flags":0,"factionID":0,"nameSeed":0,"gender":0,"race":0,"context":0,"mapID":0,"locationID":0,"buildingKey":0,"nameBank":0,"billboardArchiveIndex":0,"billboardRecordIndex":0},"discoveredThroughTalkMa